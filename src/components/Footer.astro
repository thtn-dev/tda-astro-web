---
import site from '../data/site.json';
---

<footer id="contact" class="mt-auto border-t border-[var(--color-rose)]/15 bg-white/60 backdrop-blur-md py-12 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
    <!-- Mini cute flower icon -->
    <div class="w-10 h-10 rounded-full bg-[var(--color-blush)] flex items-center justify-center text-lg mb-4 shadow-sm select-none">
      🌸
    </div>

    <h3 class="text-lg font-bold text-[var(--color-cocoa)] mb-2">
      Kết nối cùng {site.name}
    </h3>

    <p class="text-sm text-[var(--color-muted)] max-w-md mb-6 leading-relaxed">
      Ghé thăm những góc nhỏ khác của mình hoặc gửi một lời nhắn dịu dàng qua các kênh dưới đây nha.
    </p>

    <!-- Social links (Inline SVGs) -->
    <div class="flex items-center gap-3 sm:gap-4 mb-8">
      {site.socials.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
          class="w-11 h-11 rounded-full bg-[var(--color-cream)] hover:bg-[var(--color-rose)] text-[var(--color-cocoa)] hover:text-white border border-[var(--color-rose)]/25 flex items-center justify-center shadow-soft hover:shadow-hover transition-all duration-200 transform hover:-translate-y-1"
        >
          {item.icon === 'instagram' && (
            <svg class="w-5 h-5 fill-none stroke-currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          )}

          {item.icon === 'tiktok' && (
            <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.41a6.33 6.33 0 0 0-.85-.06A6.34 6.34 0 0 0 3.14 15.7a6.34 6.34 0 0 0 9.15 5.61 6.27 6.27 0 0 0 3.53-5.61V8.52a8.27 8.27 0 0 0 4.77 1.48v-3.31Z"/>
            </svg>
          )}

          {item.icon === 'threads' && (
            <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm3.73 13.91c-.83 1.25-2.07 1.89-3.69 1.89-2.73 0-4.48-1.84-4.48-4.7 0-3.07 2.03-4.9 4.67-4.9 2.45 0 4.09 1.54 4.09 3.86 0 .34-.03.7-.08 1.07h-6.7c.14 1.79 1.2 2.82 2.67 2.82 1.05 0 1.82-.44 2.4-1.32l1.12.98Zm-5.75-4.43h4.74c-.11-1.35-.93-2.18-2.26-2.18-1.37 0-2.3 0.86-2.48 2.18Z"/>
            </svg>
          )}

          {item.icon === 'mail' && (
            <svg class="w-5 h-5 fill-none stroke-currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="text-xs text-[var(--color-muted)] font-medium">
      {site.copyright}
    </p>
  </div>
</footer>
